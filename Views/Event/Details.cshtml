@model EventEase.Models.Event
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Event Details";
}

<section class="max-w-3xl mx-auto py-12">

    <div class="bg-white shadow-xl rounded-2xl p-8">

        <h1 class="text-3xl font-bold text-gray-800 mb-6">
            @Model.EventName
        </h1>

        <div class="space-y-4 text-gray-700">
            <div>
                <p class="text-sm text-gray-500 font-medium">Venue</p>
                <p class="mt-1">@Model.Venue?.VenueName</p>
            </div>
            <div>
                <p class="text-sm text-gray-500 font-medium">Description</p>
                <p class="mt-1">@Model.Description</p>
            </div>

            <div>
                <p class="text-sm text-gray-500 font-medium">Date</p>
                <p class="mt-1">@Model.EventDate.Value.ToShortDateString()</p>
            </div>

            <div>
                <p class="text-sm text-gray-500 font-medium">Type</p>
                <p class="mt-1">@Model.EventType?.Name</p>
            </div>

        </div>

        <div class="flex justify-between items-center mt-8 pt-6 border-t">

            <a asp-action="Index"
               class="text-gray-600 hover:text-gray-800 font-medium transition">
                ← Back
            </a>

            <a asp-action="Edit" asp-route-id="@Model.EventId"
               class="bg-indigo-600 text-white px-5 py-2 rounded-xl shadow hover:bg-indigo-700 transition font-semibold">
                Edit Event
            </a>

        </div>

    </div>

</section>