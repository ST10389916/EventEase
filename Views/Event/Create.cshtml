@model EventEase.Models.Event
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Event";
}

<section class="max-w-3xl mx-auto py-12">

    <div class="bg-white shadow-xl rounded-2xl p-8">

        <h1 class="text-2xl font-bold text-gray-800 mb-6">
            Create Event
        </h1>

        <form asp-action="Create" class="space-y-6">

            <div>
                <label asp-for="EventName" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <input asp-for="EventName"
                       class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="EventName" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <textarea asp-for="Description"
                          class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:ring-2 focus:ring-indigo-500"></textarea>
                <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="EventDate" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <input asp-for="EventDate" type="date"
                       class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="EventDate" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="EventTypeId" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <select asp-for="EventTypeId"
                        asp-items="ViewBag.EventTypeId"
                        class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:ring-2 focus:ring-indigo-500">
                </select>
                <span asp-validation-for="EventTypeId" class="text-red-500 text-sm"></span>
            </div>

            <div class="flex justify-between pt-6 border-t">
                <a asp-action="Index"
                   class="text-gray-600 hover:text-gray-800 font-medium">
                    Cancel
                </a>

                <button type="submit"
                        class="bg-indigo-600 text-white px-6 py-2 rounded-xl shadow hover:bg-indigo-700 transition font-semibold">
                    Create Event
                </button>
            </div>

        </form>

    </div>

</section>