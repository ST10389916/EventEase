<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-100">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EventEase</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="h-full flex flex-col">

    <!-- Top Navigation -->
    <header class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">

            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index"
               class="text-2xl font-bold text-gray-800 tracking-tight hover:text-indigo-600 transition">
                EventEase
            </a>

            <!-- Navigation -->
            <nav class="flex items-center gap-8 text-sm font-medium">

                <a asp-controller="Home" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" 
                                           && ViewContext.RouteData.Values["action"]?.ToString() == "Index"
                                           ? "text-indigo-600"
                                           : "text-gray-600 hover:text-indigo-600") transition">
                    Home
                </a>

                <a asp-controller="Venue" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Venue"
                                           ? "text-indigo-600"
                                           : "text-gray-600 hover:text-indigo-600") transition">
                    Venues
                </a>

                <a asp-controller="Booking" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking"
                                           ? "text-indigo-600"
                                           : "text-gray-600 hover:text-indigo-600") transition">
                    Bookings
                </a>

                <a asp-controller="Event" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Event"
                                           ? "text-indigo-600"
                                           : "text-gray-600 hover:text-indigo-600") transition">
                    Events
                </a>

                <a asp-controller="Home" asp-action="Privacy"
                   class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Privacy"
                                           ? "text-indigo-600"
                                           : "text-gray-600 hover:text-indigo-600") transition">
                    Privacy
                </a>

            </nav>
        </div>
    </header>

    <!-- Page Content -->
    <main class="flex-grow max-w-7xl mx-auto px-6 py-10 w-full">
        <div class="bg-white shadow-lg rounded-2xl p-8">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t">
        <div class="max-w-7xl mx-auto px-6 py-6 text-center text-gray-500 text-sm">
            &copy; @DateTime.Now.Year - EventEase. All rights reserved.
        </div>
    </footer>

    @RenderSection("Scripts", required: false)

    <!-- jQuery Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>