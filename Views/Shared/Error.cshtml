@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="flex items-center justify-center min-h-[70vh] px-6">

    <div class="bg-white shadow-2xl rounded-3xl p-10 max-w-2xl text-center">

        <div class="bg-red-100 text-red-600 rounded-full p-5 w-20 h-20 mx-auto mb-6 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg"
                 class="h-10 w-10"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke="currentColor"
                 stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 9v3m0 3h.01M4.93 19h14.14c1.54 0 2.5-1.67
                      1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46
                      0L3.2 16c-.77 1.33.19 3 1.73 3z" />
            </svg>
        </div>

        <h1 class="text-3xl font-bold text-gray-800 mb-4">
            Something went wrong
        </h1>

        <p class="text-gray-600 mb-6">
            An unexpected error occurred while processing your request.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="bg-gray-100 rounded-lg p-4 mb-6 text-sm text-gray-700">
                <strong>Request ID:</strong>
                <span class="text-indigo-600">@Model.RequestId</span>
            </div>
        }

        <a asp-controller="Home" asp-action="Index"
           class="inline-block bg-indigo-600 text-white px-6 py-2 rounded-xl
                  shadow hover:bg-indigo-700 transition font-semibold">
            Go Home
        </a>

    </div>

</section>