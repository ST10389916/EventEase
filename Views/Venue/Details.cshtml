@model EventEase.Models.Venue
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Venue Details";
}

<section class="max-w-3xl mx-auto py-12">

    <div class="bg-white shadow-xl rounded-2xl p-8">

        <h1 class="text-3xl font-bold text-gray-800 mb-6">
            @Model.VenueName
        </h1>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 class="w-full h-64 object-cover rounded-xl mb-6 shadow" />
        }

        <div class="space-y-4 text-gray-700">

            <div>
                <p class="text-sm text-gray-500">Location</p>
                <p class="font-semibold">@Model.Location</p>
            </div>

            <div>
                <p class="text-sm text-gray-500">Capacity</p>
                <p class="font-semibold">@Model.Capacity</p>
            </div>

            <div>
                <p class="text-sm text-gray-500">Availability</p>
                <span class="px-3 py-1 rounded-full text-xs font-semibold
                    @(Model.IsAvailable ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                    @(Model.IsAvailable ? "Available" : "Unavailable")
                </span>
            </div>

        </div>

        <div class="flex justify-between mt-8 pt-6 border-t">
            <a asp-action="Index" class="text-gray-600 hover:text-gray-800">
                ← Back
            </a>

            <a asp-action="Edit" asp-route-id="@Model.VenueId"
               class="bg-indigo-600 text-white px-5 py-2 rounded-xl hover:bg-indigo-700 transition font-semibold">
                Edit Venue
            </a>
        </div>

    </div>

</section>