@model EventEase.Models.Venue
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Delete Venue";
}

<section class="max-w-2xl mx-auto py-12">

    <div class="bg-white shadow-xl rounded-2xl p-8 border border-red-100">

        <h1 class="text-2xl font-bold text-red-600 mb-6">
            Delete Venue
        </h1>

        <p class="text-gray-600 mb-6">
            Are you sure you want to delete this venue?
        </p>

        <div class="space-y-4 mb-6">
            <p><strong>Name:</strong> @Model.VenueName</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Capacity:</strong> @Model.Capacity</p>
        </div>

        <form asp-action="Delete" class="flex justify-between">
            <input type="hidden" asp-for="VenueId" />

            <a asp-action="Index" class="text-gray-600">
                Cancel
            </a>

            <button type="submit"
                    class="bg-red-600 text-white px-6 py-2 rounded-xl hover:bg-red-700 transition font-semibold">
                Delete
            </button>
        </form>

    </div>

</section>