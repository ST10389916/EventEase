@model EventEase.Models.Venue
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Venue";
}

<section class="max-w-3xl mx-auto py-12">

    <div class="bg-white shadow-xl rounded-2xl p-8">

        <div class="mb-8">
            <h1 class="text-2xl font-bold text-gray-800">
                Edit Venue
            </h1>
            <p class="text-gray-500 text-sm">
                Update venue information below.
            </p>
        </div>

        <form asp-action="Edit" enctype="multipart/form-data" class="space-y-6">

            <!-- Hidden Fields -->
            <input type="hidden" asp-for="VenueId" />
            <input type="hidden" asp-for="ImageUrl" />

            <!-- Venue Name -->
            <div>
                <label asp-for="VenueName"
                       class="block text-sm font-semibold text-gray-700 mb-2"></label>

                <input asp-for="VenueName"
                       class="w-full border border-gray-300 rounded-xl px-4 py-2
                              focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />

                <span asp-validation-for="VenueName"
                      class="text-red-500 text-sm"></span>
            </div>

            <!-- Location -->
            <div>
                <label asp-for="Location"
                       class="block text-sm font-semibold text-gray-700 mb-2"></label>

                <input asp-for="Location"
                       class="w-full border border-gray-300 rounded-xl px-4 py-2
                              focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />

                <span asp-validation-for="Location"
                      class="text-red-500 text-sm"></span>
            </div>

            <!-- Capacity -->
            <div>
                <label asp-for="Capacity"
                       class="block text-sm font-semibold text-gray-700 mb-2"></label>

                <input asp-for="Capacity"
                       class="w-full border border-gray-300 rounded-xl px-4 py-2
                              focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />

                <span asp-validation-for="Capacity"
                      class="text-red-500 text-sm"></span>
            </div>

            <!-- Current Image Preview -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div>
                    <p class="text-sm font-semibold text-gray-700 mb-2">
                        Current Image
                    </p>
                    <img src="@Model.ImageUrl"
                         class="w-full h-48 object-cover rounded-xl shadow mb-3" />
                </div>
            }

            <!-- Upload New Image -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Upload New Image
                </label>

                <input type="file" name="ImageFile"
                       class="w-full border border-gray-300 rounded-xl px-4 py-2 bg-gray-50" />
            </div>

            <!-- Availability Toggle -->
            <div class="flex items-center gap-3 pt-4">
                <input asp-for="IsAvailable"
                       class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" />
                <label asp-for="IsAvailable"
                       class="text-sm font-medium text-gray-700"></label>
            </div>

            <!-- Buttons -->
            <div class="flex justify-between items-center pt-6 border-t">

                <a asp-action="Index"
                   class="text-gray-600 hover:text-gray-800 font-medium">
                    Cancel
                </a>

                <button type="submit"
                        class="bg-indigo-600 text-white px-6 py-2 rounded-xl
                               shadow hover:bg-indigo-700 transition font-semibold">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}