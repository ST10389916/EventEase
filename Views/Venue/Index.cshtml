@model IEnumerable<Venue>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Venues";
}

<section class="max-w-7xl mx-auto py-12">

    <div class="flex justify-between items-center mb-10">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">Venues</h1>
            <p class="text-gray-500">Manage all available venues</p>
        </div>

        <div class="flex gap-3">
            <a asp-action="Create"
               class="bg-indigo-600 text-white px-5 py-2 rounded-xl shadow hover:bg-indigo-700 transition font-semibold">
                + Create Venue
            </a>

            <a asp-controller="Booking" asp-action="Index"
               class="bg-gray-200 text-gray-700 px-5 py-2 rounded-xl hover:bg-gray-300 transition font-semibold">
                View Bookings
            </a>
        </div>
    </div>

    <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">

                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase">Venue</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase">Location</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase">Capacity</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase">Image</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase">Available</th>
                        <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-gray-200 bg-white">

                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition">

                            <td class="px-6 py-4 font-semibold text-gray-800">
                                @item.VenueName
                            </td>

                            <td class="px-6 py-4 text-gray-600">
                                @item.Location
                            </td>

                            <td class="px-6 py-4 text-gray-600">
                                @item.Capacity
                            </td>

                            <td class="px-6 py-4">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         class="w-20 h-14 object-cover rounded-lg shadow"
                                         alt="Venue Image" />
                                }
                            </td>

                            <td class="px-6 py-4">
                                <span class="px-3 py-1 rounded-full text-xs font-semibold
                                        @(item.IsAvailable ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                                    @(item.IsAvailable ? "Available" : "Unavailable")
                                </span>
                            </td>

                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2 whitespace-nowrap">
                                    <a href="/Venue/Details/@item.VenueId"
                                       class="bg-blue-100 text-blue-700 px-3 py-1 rounded-lg text-sm hover:bg-blue-200 transition">
                                        Details
                                    </a>

                                    <a href="/Venue/Edit/@item.VenueId"
                                       class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-lg text-sm hover:bg-yellow-200 transition">
                                        Edit
                                    </a>

                                    <a href="/Venue/Delete/@item.VenueId"
                                       class="bg-red-100 text-red-700 px-3 py-1 rounded-lg text-sm hover:bg-red-200 transition">
                                        Delete
                                    </a>
                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>
    </div>

</section>