@using EventEase.Models
@model IEnumerable<Booking>

@{
    ViewData["Title"] = "Bookings";
}

<section class="max-w-7xl mx-auto py-16">

    <!-- Header -->
    <div class="flex justify-between items-center mb-10">
        <div>
            <h1 class="text-3xl font-bold text-gray-800 mb-2">
                Bookings
            </h1>
            <p class="text-gray-500">
                Manage all event bookings in one place.
            </p>
        </div>

        <a href="/Booking/Create"
           class="bg-indigo-600 text-white px-6 py-3 rounded-xl
                  shadow-md hover:bg-indigo-700 transition font-semibold">
            + Create Booking
        </a>
    </div>

    <!-- Table Card -->
    <div class="bg-white shadow-xl rounded-2xl overflow-hidden">

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">

                <!-- Table Head -->
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                            Venue
                        </th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                            Event
                        </th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                            Booking Date
                        </th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                            Event Date
                        </th>
                        <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">
                            Actions
                        </th>
                    </tr>
                </thead>

                <!-- Table Body -->
                <tbody class="divide-y divide-gray-200 bg-white">

                    @foreach (var booking in Model)
                    {
                        <tr class="hover:bg-gray-50 transition">

                            <td class="px-6 py-4 text-sm font-medium text-gray-800">
                                @booking.Venue?.VenueName
                            </td>

                            <td class="px-6 py-4 text-sm text-gray-600">
                                @booking.Event?.EventName
                            </td>

                            <td class="px-6 py-4 text-sm text-gray-600">
                                @booking.BookingDate.ToShortDateString()
                            </td>

                            <td class="px-6 py-4 text-sm text-gray-600">
                                @booking.EventDate.ToShortDateString()
                            </td>

                            <!-- Action Buttons -->
                            <td class="px-6 py-4 text-right space-x-2">

                                <a href="/Booking/Details/@booking.BookingId"
                                   class="inline-block bg-blue-100 text-blue-600
                                              px-3 py-1 rounded-lg text-sm font-medium
                                              hover:bg-blue-200 transition">
                                    Details
                                </a>

                                <a href="/Booking/Edit/@booking.BookingId"
                                   class="inline-block bg-yellow-100 text-yellow-700
                                              px-3 py-1 rounded-lg text-sm font-medium
                                              hover:bg-yellow-200 transition">
                                    Edit
                                </a>

                                <a href="/Booking/Delete/@booking.BookingId"
                                   class="inline-block bg-red-100 text-red-600
                                              px-3 py-1 rounded-lg text-sm font-medium
                                              hover:bg-red-200 transition">
                                    Delete
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>

    </div>

</section>